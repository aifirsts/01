<UserControl x:Class="SOCpit.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SOCpit.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource PrimaryBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Dashboard" FontSize="24" FontWeight="Bold" 
                       Margin="0,0,0,20" Foreground="{StaticResource AccentBrush}" />

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Threat Statistics -->
                <Border Grid.Column="0" Margin="0,0,10,0" Padding="15"
                        Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="Threats" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding TotalThreats}" FontSize="32" FontWeight="Bold"
                                   Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Critical" FontSize="12" Foreground="{StaticResource CriticalBrush}" />
                                <TextBlock Text="{Binding CriticalThreats}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource CriticalBrush}" />
                            </StackPanel>
                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="High" FontSize="12" Foreground="{StaticResource HighBrush}" />
                                <TextBlock Text="{Binding HighThreats}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource HighBrush}" />
                            </StackPanel>
                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="Medium" FontSize="12" Foreground="{StaticResource MediumBrush}" />
                                <TextBlock Text="{Binding MediumThreats}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource MediumBrush}" />
                            </StackPanel>
                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="Low" FontSize="12" Foreground="{StaticResource LowBrush}" />
                                <TextBlock Text="{Binding LowThreats}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource LowBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Vulnerability Statistics -->
                <Border Grid.Column="1" Margin="10,0,10,0" Padding="15"
                        Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="Vulnerabilities" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding TotalVulnerabilities}" FontSize="32" FontWeight="Bold"
                                   Margin="0,10,0,0" Foreground="{StaticResource WarningBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Critical" FontSize="12" Foreground="{StaticResource CriticalBrush}" />
                                <TextBlock Text="{Binding CriticalVulnerabilities}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource CriticalBrush}" />
                            </StackPanel>
                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="High" FontSize="12" Foreground="{StaticResource HighBrush}" />
                                <TextBlock Text="{Binding HighVulnerabilities}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource HighBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Incident Statistics -->
                <Border Grid.Column="2" Margin="10,0,10,0" Padding="15"
                        Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="Incidents" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding TotalIncidents}" FontSize="32" FontWeight="Bold"
                                   Margin="0,10,0,0" Foreground="{StaticResource ErrorBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Open" FontSize="12" Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="{Binding OpenIncidents}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>
                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="Resolved" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="{Binding ResolvedIncidents}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Host Statistics -->
                <Border Grid.Column="3" Margin="10,0,0,0" Padding="15"
                        Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="Hosts" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding TotalHosts}" FontSize="32" FontWeight="Bold"
                                   Margin="0,10,0,0" Foreground="{StaticResource InfoBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Active" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="{Binding ActiveHosts}" FontSize="18" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                            <StackPanel Margin="20,0,0,0">
                                <TextBlock Text="Inactive" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding InactiveHosts}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recent Items Section -->
                <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Recent Items" FontSize="18" FontWeight="Bold" 
                               Margin="0,0,0,10" Foreground="{StaticResource AccentBrush}" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Recent Threats -->
                        <Border Grid.Column="0" Margin="0,0,10,0" Padding="10"
                                Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="Recent Threats" FontSize="14" FontWeight="SemiBold" 
                                           Margin="0,0,0,10" Foreground="{StaticResource SecondaryTextBrush}" />
                                <ItemsControl ItemsSource="{Binding RecentThreats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="10"
                                                    Background="{StaticResource ItemBackgroundBrush}" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" 
                                                               Foreground="{StaticResource SecondaryTextBrush}" 
                                                               TextTrimming="CharacterEllipsis" 
                                                               MaxHeight="40" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBlock Text="Severity: " FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                                        <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" 
                                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}" />
                                                        <TextBlock Text=" | " FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,5,0" />
                                                        <TextBlock Text="{Binding Status}" FontSize="10" 
                                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Recent Vulnerabilities -->
                        <Border Grid.Column="1" Margin="10,0,10,0" Padding="10"
                                Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="Recent Vulnerabilities" FontSize="14" FontWeight="SemiBold" 
                                           Margin="0,0,0,10" Foreground="{StaticResource SecondaryTextBrush}" />
                                <ItemsControl ItemsSource="{Binding RecentVulnerabilities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="10"
                                                    Background="{StaticResource ItemBackgroundBrush}" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CveId}" FontSize="14" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" 
                                                               Foreground="{StaticResource SecondaryTextBrush}" 
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBlock Text="Severity: " FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                                        <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" 
                                                                   Foreground="{Binding Severity, Converter={StaticResource VulnerabilitySeverityToColorConverter}}" />
                                                        <TextBlock Text=" | " FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,5,0" />
                                                        <TextBlock Text="{Binding Status}" FontSize="10" 
                                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Recent Incidents -->
                        <Border Grid.Column="2" Margin="10,0,0,0" Padding="10"
                                Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="Recent Incidents" FontSize="14" FontWeight="SemiBold" 
                                           Margin="0,0,0,10" Foreground="{StaticResource SecondaryTextBrush}" />
                                <ItemsControl ItemsSource="{Binding RecentIncidents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="10"
                                                    Background="{StaticResource ItemBackgroundBrush}" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" 
                                                               Foreground="{StaticResource SecondaryTextBrush}" 
                                                               TextTrimming="CharacterEllipsis" 
                                                               MaxHeight="40" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBlock Text="Severity: " FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                                        <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" 
                                                                   Foreground="{Binding Severity, Converter={StaticResource IncidentSeverityToColorConverter}}" />
                                                        <TextBlock Text=" | " FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,5,0" />
                                                        <TextBlock Text="{Binding Status}" FontSize="10" 
                                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
