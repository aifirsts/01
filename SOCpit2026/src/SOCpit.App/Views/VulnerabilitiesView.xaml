<UserControl x:Class="SOCpit.App.Views.VulnerabilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource PrimaryBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Vulnerabilities" FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource AccentBrush}" />
            <Viewbox Width="24" Height="24" Margin="10,0,0,0">
                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" Fill="{StaticResource WarningBrush}" />
            </Viewbox>
        </StackPanel>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Margin="0,0,0,20" Padding="15"
                Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" ItemsSource="{Binding SeverityFilters}" 
                          SelectedItem="{Binding SelectedSeverityFilter, Mode=TwoWay}" 
                          Margin="0,0,10,0" Width="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" 
                          SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" 
                          Margin="0,0,10,0" Width="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Grid.Column="2" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Width="200" Margin="0,0,10,0" />

                <Button Grid.Column="3" Content="Filter" Command="{Binding FilterCommand}" 
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" />

                <Button Grid.Column="4" Content="Refresh" Command="{Binding RefreshCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Vulnerabilities List -->
            <Border Grid.Row="0" Padding="10"
                    Background="{StaticResource CardBackgroundBrush}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Vulnerabilities}" 
                                  IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToInverseVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="15"
                                        Background="{StaticResource ItemBackgroundBrush}" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding CveId}" FontSize="16" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock Text="{Binding Name}" FontSize="14" 
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" 
                                                       Foreground="{StaticResource SecondaryTextBrush}" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       MaxHeight="40" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="Target: " FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding TargetId}" FontSize="10" 
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text=" | " FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,5,0" />
                                                <TextBlock Text="CVSS: " FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding CvssScore}" FontSize="10" 
                                                           Foreground="{StaticResource WarningBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Margin="10,0,0,0" Padding="5,2"
                                                Background="{Binding Severity, Converter={StaticResource VulnerabilitySeverityToBackgroundConverter}}"
                                                CornerRadius="4">
                                            <TextBlock Text="{Binding Severity}" FontSize="12" FontWeight="Bold" 
                                                       Foreground="{Binding Severity, Converter={StaticResource VulnerabilitySeverityToForegroundConverter}}" />
                                        </Border>

                                        <Border Grid.Column="2" Margin="10,0,0,0" Padding="5,2"
                                                Background="{StaticResource StatusBackgroundBrush}" CornerRadius="4">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold" 
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{Binding PublishedAt, StringFormat=yyyy-MM-dd}" 
                                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" 
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Action Bar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Add" Command="{Binding AddCommand}" 
                        Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Edit" Command="{Binding EditCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" 
                        Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
