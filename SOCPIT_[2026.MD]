name: Build and Test

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]

jobs:
  build:
    runs-on: windows-latest
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Setup .NET
      uses: actions/setup-dotnet@v3
      with:
        dotnet-version: 8.0.x
    
    - name: Restore dependencies
      run: dotnet restore SOCpit.sln
    
    - name: Build
      run: dotnet build SOCpit.sln -c Release --no-restore
    
    - name: Test
      run: dotnet test SOCpit.sln -c Release --no-build
    
    - name: Publish
      run: dotnet publish src/SOCpit.App/SOCpit.App.csproj -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o publish/
    
    - name: Upload artifact
      uses: actions/upload-artifact@v3
      with:
        name: SOCpit-EXE
        path: publish/
```

